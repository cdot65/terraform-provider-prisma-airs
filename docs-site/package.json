{
  "name": "prisma-airs-terraform-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "check": "npm run check:source && npm run typecheck && npm run build && npm run test:browser && npm run test:parity",
    "check:source": "python3 scripts/design_source.py && python3 scripts/check_content.py && python3 scripts/schema_reference.py --check",
    "test:parity": "python3 scripts/check_design_parity.py",
    "generate:reference": "python3 scripts/schema_reference.py"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/theme-common": "3.10.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5",
